<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>RaceMind</AssemblyName>
    <RootNamespace>RaceMind</RootNamespace>
    <StartupObject>RaceMind.Program</StartupObject>
    <Version>0.1.0</Version>
    <ApplicationIcon>Assets\racemind.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Velopack" Version="1.2.0" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\racemind-logo.png" />
    <Resource Include="Assets\racemind.ico" />
  </ItemGroup>
</Project>
