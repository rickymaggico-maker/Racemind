<Window x:Class="RaceMind.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RaceMind" Width="1180" Height="760" MinWidth="980" MinHeight="680"
        WindowStartupLocation="CenterScreen" Background="#071014">
    <Window.Resources>
        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#F3F7F8"/></Style>
        <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="#0D171C"/><Setter Property="BorderBrush" Value="#1B2B32"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="20"/><Setter Property="Padding" Value="22"/><Setter Property="Margin" Value="0,0,18,18"/></Style>
        <Style x:Key="RaceButton" TargetType="Button">
            <Setter Property="Foreground" Value="#F3F7F8"/>
            <Setter Property="Background" Value="#0D171C"/>
            <Setter Property="BorderBrush" Value="#263941"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="11">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#14242B"/><Setter TargetName="Chrome" Property="BorderBrush" Value="#3A535E"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#091217"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.45"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="34">
        <Grid.RowDefinitions>
            <RowDefinition Height="100"/>
            <RowDefinition Height="100"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="62"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Image Source="Assets/racemind-logo.png" Width="82" Height="82" Stretch="Uniform"/>
                <StackPanel Margin="18,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="RACEMIND" FontSize="30" FontWeight="Bold"/>
                    <TextBlock Text="AI RACE ENGINEER" FontSize="13" Foreground="#7D8E96" Margin="2,5,0,0"/>
                </StackPanel>
            </StackPanel>
            <Border Grid.Column="1" Background="#0B1519" BorderBrush="#2B3B42" BorderThickness="1" CornerRadius="22" Padding="20,11" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal"><Ellipse x:Name="StatusDot" Width="10" Height="10" Fill="#65757D" Margin="0,0,10,0"/><TextBlock x:Name="StatusText" Text="IN ATTESA" FontWeight="Bold" FontSize="13"/></StackPanel>
            </Border>
        </Grid>
        <StackPanel Grid.Row="1">
            <TextBlock Text="Garage" FontSize="46" FontWeight="Bold"/>
            <TextBlock x:Name="Subtitle" Text="In attesa di Le Mans Ultimate." FontSize="17" Foreground="#7D8E96" Margin="1,5,0,0"/>
        </StackPanel>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
            <Border Style="{StaticResource Card}" Grid.Row="0" Grid.Column="0">
                <StackPanel>
                    <TextBlock Text="SESSIONE" FontSize="12" FontWeight="Bold" Foreground="#7D8E96"/>
                    <TextBlock Text="CIRCUITO" FontSize="11" Foreground="#7D8E96" Margin="0,14,0,0"/>
                    <TextBlock x:Name="TrackText" Text="—" FontSize="24" FontWeight="Bold"/>
                    <TextBlock Text="PILOTA" FontSize="11" Foreground="#7D8E96" Margin="0,10,0,0"/>
                    <TextBlock x:Name="DriverText" Text="—" FontSize="21" FontWeight="Bold"/>
                    <TextBlock Text="AUTO" FontSize="11" Foreground="#7D8E96" Margin="0,10,0,0"/>
                    <TextBlock x:Name="CarText" Text="—" FontSize="21" FontWeight="Bold"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Grid.Row="0" Grid.Column="1">
                <StackPanel>
                    <TextBlock Text="ACQUISIZIONE" FontSize="12" FontWeight="Bold" Foreground="#7D8E96"/>
                    <TextBlock x:Name="CaptureTitle" Text="Non attiva" FontSize="30" FontWeight="Bold" Margin="0,20,0,0"/>
                    <TextBlock x:Name="CaptureDetail" Text="Si attiverà automaticamente durante lo stint." FontSize="15" Foreground="#7D8E96" TextWrapping="Wrap" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Grid.Row="1" Grid.Column="0">
                <StackPanel>
                    <TextBlock Text="DATI STINT" FontSize="12" FontWeight="Bold" Foreground="#7D8E96"/>
                    <Grid Margin="0,18,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,18,14">
                            <TextBlock Text="VELOCITÀ MAX" FontSize="10" Foreground="#7D8E96"/>
                            <TextBlock x:Name="MaxSpeedText" Text="—" FontSize="22" FontWeight="Bold" Margin="0,4,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,14">
                            <TextBlock Text="VELOCITÀ MEDIA" FontSize="10" Foreground="#7D8E96"/>
                            <TextBlock x:Name="AvgSpeedText" Text="—" FontSize="22" FontWeight="Bold" Margin="0,4,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,18,0">
                            <TextBlock Text="CARBURANTE USATO" FontSize="10" Foreground="#7D8E96"/>
                            <TextBlock x:Name="FuelUsedText" Text="—" FontSize="22" FontWeight="Bold" Margin="0,4,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1">
                            <TextBlock Text="UTILIZZO PEDALI" FontSize="10" Foreground="#7D8E96"/>
                            <TextBlock x:Name="PedalUsageText" Text="—" FontSize="18" FontWeight="Bold" Margin="0,6,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Grid.Row="1" Grid.Column="1">
                <StackPanel>
                    <TextBlock Text="STATO" FontSize="12" FontWeight="Bold" Foreground="#7D8E96"/>
                    <TextBlock x:Name="ConnectionText" Text="LMU non rilevato" FontSize="23" FontWeight="Bold" Margin="0,16,0,0"/>
                    <TextBlock Text="RaceMind resta silenzioso in pista e torna disponibile ai box." FontSize="14" Foreground="#7D8E96" TextWrapping="Wrap" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
        <Grid Grid.Row="3" Margin="0,4,18,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Button x:Name="OpenSessionsButton" Grid.Column="0" Style="{StaticResource RaceButton}" Content="APRI SESSIONI" Width="145" Height="42" VerticalAlignment="Center" Click="OpenSessions_Click"/>
            <Button x:Name="CheckUpdatesButton" Grid.Column="1" Style="{StaticResource RaceButton}" Content="VERIFICA AGGIORNAMENTI" Width="205" Height="42" Margin="10,0,0,0" VerticalAlignment="Center" Click="CheckUpdates_Click"/>
            <TextBlock x:Name="UpdateStatusText" Grid.Column="2" Text="Aggiornamenti automatici attivi" FontSize="12" Foreground="#65757D" Margin="16,0,0,0" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="RACEMIND" FontSize="11" FontWeight="Bold" Foreground="#42535B" Margin="0,0,12,0"/>
                <TextBlock x:Name="VersionText" Text="—" FontSize="11" Foreground="#42535B"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
